#Makefile
#Vincent Fealy

PYTHON=python3
SCRIPT=crypto_project.py

#running the script this should display the version of python and the name of the script
run:
	$(PYTHON) $(SCRIPT)

#Clean up generated or temp files
#this is only needed if program creates files, it currently does not
clean:
	@echo "No files to clean for Python"

help:
	@echo "Makefile options:"
	@echo "  make run    - Run the cryptography project"
	@echo "  make clean  - Clean any generated files"
